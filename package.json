{
  "name": "clipqr",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "scripts": {
    "dev": "nsh run App.tsx",
    "build": "nsh build App.tsx",
    "check": "nsh check App.tsx",
    "test": "nsh test App.test.tsx",
    "sync:i18n": "bun scripts/generate-nsh-locales.ts",
    "package:linux": "nsh package App.tsx --target linux",
    "package:macos": "nsh package App.tsx --target macos",
    "package:windows": "nsh package App.tsx --target windows",
    "check:i18n": "bun scripts/check-locales.ts",
    "test:site-locale": "bun scripts/test-site-locale.ts",
    "website:dev": "cd site && bun run dev",
    "website:build": "cd site && bun run build"
  },
  "dependencies": {},
  "devDependencies": {}
}
